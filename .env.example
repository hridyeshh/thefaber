# Contact form → Google Sheet + an email to team@thefaber.in: the Apps Script web app URL
# (setup steps in scripts/contact-sheet.gs). Without it the form says to call or email instead.
CONTACT_SHEET_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# WhatsApp click-to-chat, digits only with country code (e.g. 919876543210). The button hides when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=
