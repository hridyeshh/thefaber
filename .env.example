# Contact form → Google Sheet: the Apps Script web app URL (setup steps in scripts/contact-sheet.gs).
# Without it the form says to WhatsApp instead.
CONTACT_SHEET_URL=https://script.google.com/macros/s/xxxxxxxx/exec

# Your live address, for link previews (set once the domain is bought).
NEXT_PUBLIC_SITE_URL=https://thefaber.example

# WhatsApp click-to-chat, digits only with country code (e.g. 919876543210). Buttons hide when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=
